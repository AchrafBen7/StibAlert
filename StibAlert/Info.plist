<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Blayse</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>fr</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>fr</string>
		<string>nl</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Blayse utilise ta position pour afficher les arrêts proches et calculer ton itinéraire en temps réel.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- NFCReaderUsageDescription retiré avec le masquage de l'écran MoBIB.
	     Une permission déclarée pour une fonctionnalité INJOIGNABLE est un motif
	     de rejet App Store (même cas que le micro, hérité de l'assistant vocal
	     supprimé). À remettre le jour où l'entrée MoBIB est rouverte dans le
	     profil — le code de scan, lui, n'a pas bougé. -->
	<key>com.apple.developer.nfc.readersession.iso7816.select-identifiers</key>
	<array>
		<!-- Calypso "1TIC.ICA" AID — used by MoBIB / STIB-MIVB Brussels -->
		<string>315449432E494341</string>
		<!-- Calypso B Prime (older MoBIB revisions) -->
		<string>A0000004040125009101</string>
		<!-- Calypso applet generic -->
		<string>334D54520010</string>
		<!-- Mifare DESFire DF7560 (some MoBIB variants) -->
		<string>D2760000850100</string>
	</array>
	<key>OneSignalAppID</key>
	<string>c572317d-1a24-49fa-9631-b6556438ae34</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>stibalert</string>
			</array>
		</dict>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>DelaGothicOne-Regular.ttf</string>
		<string>Montserrat-Regular.ttf</string>
		<string>Montserrat-SemiBold.ttf</string>
	</array>
</dict>
</plist>
